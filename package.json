{
  "name": "eneye",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,html,ts}\" \"src-tauri/*.json\" \"src-tauri/capabilities/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,html,ts}\" \"src-tauri/*.json\" \"src-tauri/capabilities/*.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "dompurify": "3.4.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
